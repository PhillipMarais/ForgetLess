{
  "expo": {
    "name": "ForgetLess",
    "slug": "forgetless",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "forgetless",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.mts.forgetless",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "app.mts.forgetless",
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0D0E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      "./plugins/with-android-cmake-dir",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "ForgetLess uses your photos when you attach a picture to a task, event or note.",
          "cameraPermission": "ForgetLess uses the camera when you take a picture for a task, event or note.",
          "microphonePermission": "ForgetLess uses the microphone when you speak a note."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "ForgetLess uses the microphone when you speak a note.",
          "speechRecognitionPermission": "ForgetLess turns what you say into note text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/chakra-petch/700Bold/ChakraPetch_700Bold.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-sans/400Regular/IBMPlexSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-sans/600SemiBold/IBMPlexSans_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "Today",
              "label": "ForgetLess Today",
              "description": "Today's events and tasks; tick tasks off right here.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Calendar",
              "label": "ForgetLess Calendar",
              "description": "This month, with today and busy days marked.",
              "minWidth": "160dp",
              "minHeight": "160dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Tasks",
              "label": "ForgetLess Tasks",
              "description": "Your open tasks; tick them off right here.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "Notes",
              "label": "ForgetLess Notes",
              "description": "Your latest notes, with buttons for a new or spoken note.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "VoiceNote",
              "label": "ForgetLess Voice note",
              "description": "One tap to speak a note.",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
